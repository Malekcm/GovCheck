# ---------------------------------------------------------------------------
# GovCheck — Government Opportunity Intelligence Engine
# Copy to .env and fill in. All secrets are read ONLY by the server; none are
# ever sent to the browser or bundled into the frontend. Never commit .env.
# Hosted setup (Supabase + Render + GitHub Actions): docs/DEPLOY_SUPABASE_RENDER.md
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# PostgreSQL connection string. For Supabase use the "Session pooler" string
# (Project → Connect → Session pooler), e.g.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Leave empty to use the embedded PGlite database in ./data/pglite (local/offline use).
DATABASE_URL=
# Supabase signs its database certificate with its own CA. Download it from
# Project Settings → Database → SSL configuration, then supply it ONE of these ways:
#   DATABASE_SSL_CA_BASE64  the .crt file base64-encoded on one line (best for Render/GitHub secrets):
#                           base64 -w0 prod-ca-2021.crt        (macOS: base64 -i prod-ca-2021.crt)
#   DATABASE_SSL_CA_PEM     the certificate text itself (-----BEGIN CERTIFICATE----- …)
#   DATABASE_SSL_CA_FILE    path to the .crt file
# TLS certificates are always verified. DATABASE_SSL_ALLOW_UNVERIFIED=true disables
# verification and is NOT recommended.
DATABASE_SSL_CA_BASE64=
DATABASE_SSL_CA_PEM=
DATABASE_SSL_CA_FILE=
DATABASE_SSL_ALLOW_UNVERIFIED=false
# Connections per process (Supabase Free has a small connection limit).
# DATABASE_POOL_MAX=8
# Refuse to start without DATABASE_URL (set to true on hosted deployments).
# REQUIRE_DATABASE_URL=false
# Where the embedded database lives when DATABASE_URL is empty.
# PGLITE_DIR=./data/pglite

# --- One-time promotion of the local database (npm run db:promote) ------------
# The Supabase database to copy ./data/pglite into. Falls back to DATABASE_URL.
# TARGET_DATABASE_URL=

# --- Government data sources -------------------------------------------------
# SAM.gov public API key (sam.gov → Profile → Account Details → Public API Key).
# Required for: SAM Contract Opportunities API and SAM Contract Awards API.
# Not required for: SAM bulk CSV, USAspending, GSA forecasts, DHS APFS, SBA SUBNet, Grants.gov.
SAM_API_KEY=
# Daily SAM.gov request ceiling shared by ALL GovCheck processes (web app, GitHub Actions, CLI).
# Non-federal personal keys without a role: 10/day. With a role or system account: 1000/day.
SAM_DAILY_REQUEST_LIMIT=10
# Requests scheduled work must leave for manual refreshes and targeted searches
# (default: 20% of the limit, i.e. 2 of 10).
# SAM_MANUAL_RESERVE_REQUESTS=2
# Most SAM requests a single targeted search may use (one per NAICS code, plus extra pages).
# SAM_TARGETED_SEARCH_MAX_REQUESTS=3
# Priority checks: tracked (pursue/watch/capture) opportunities are re-checked when their
# live data is older than this many hours; strong matches when older than SAM_STALE_DAYS.
# SAM_TRACKED_REFRESH_HOURS=24
# SAM_STALE_DAYS=7
# SAM_PRIORITY_MIN_FIT=60
# Download SAM attachments (each download counts against the daily SAM budget).
SAM_DOWNLOAD_DOCUMENTS=false
# Bulk CSV (free, no key): focused = keep only notices relevant to the profile or already
# tracked (recommended for Supabase Free); full = keep every notice in the lookback window.
SAM_BULK_INGEST_MODE=focused
# Extra NAICS prefixes always kept by focused bulk ingestion (comma-separated).
# SAM_BULK_FOCUS_NAICS_PREFIXES=5415,5416
# Bulk CSV reconciliation keeps notices posted within this many days (plus all still-open notices).
SAM_BULK_LOOKBACK_DAYS=90
# Cap on new/changed bulk records processed per reconciliation run (the next run continues).
SAM_BULK_MAX_RECORDS_PER_RUN=4000
# Optional contact email added to the User-Agent sent to public sources.
CONTACT_EMAIL=

# --- AI (optional) -----------------------------------------------------------
# Enables Claude-based requirement extraction and plain-English summaries.
# Everything else (ingestion, search, scoring, learning) works without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_MAX_ANALYSES_PER_RUN=8
AI_AUTO_ANALYZE_MIN_FIT=65

# --- Scheduling ---------------------------------------------------------------
# In-process scheduler (checks due sources every 5 minutes on a long-running host).
# Defaults to true when NODE_ENV=production. Set to false when GitHub Actions runs
# `npm run sync:due` on a schedule (the recommended free-hosting setup).
SCHEDULER_ENABLED=
# Secret for POST /api/cron/sync (optional external schedulers).
CRON_SECRET=

# --- Storage guardrails --------------------------------------------------------
# Warn administrators when the database approaches the plan size (Supabase Free: 500 MB).
# DB_SIZE_WARN_MB=400
# DB_SIZE_LIMIT_MB=500

# --- App ---------------------------------------------------------------------
PORT=8787
APP_BASE_URL=http://localhost:5173
# Single shared password protecting the whole app (required when hosted).
APP_PASSWORD=
# Signs the login cookie. Use a long random value when hosted.
SESSION_SECRET=

# --- Throughput tuning (optional) ----------------------------------------------
DOCUMENTS_PER_RUN=40
ENRICH_PER_RUN=25
DOCUMENT_MAX_BYTES=26214400
